# Database - Session Pooler (recommended for better performance)
# Get this from Supabase: Settings > Database > Connection String > Session Pooler
DATABASE_URL="postgresql://postgres.USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Supabase API Keys
# Get these from Supabase: Settings > API
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# JWT
JWT_SECRET="change_this_to_a_long_random_secret_at_least_32_chars"

# Google Gemini AI
GEMINI_API_KEY="your_gemini_api_key_here"

# Google Places API (búsqueda de lugares turísticos reales)
# Google Cloud Console > habilitar "Places API (New)" > habilitar billing > crear API key
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"

# Vuelos (ignav.com). Cuenta gratis, sin tarjeta: 1.000 requests de regalo y
# después USD 2 cada 1.000. Hay que verificar el mail antes de que la key ande.
IGNAV_API_KEY="your_ignav_api_key_here"
# Poné "true" para usar vuelos fixture sin gastar requests. Útil en dev/demos.
IGNAV_MOCK="false"

# RapidAPI (Booking COM para alojamiento)
# Crear cuenta en rapidapi.com y suscribirse (plan free)
RAPIDAPI_KEY="your_rapidapi_key_here"
# Poné "true" para usar datos fixture de alojamiento (sin gastar cuota de
# RapidAPI). Si IGNAV_MOCK no está definida, esta también mockea los vuelos.
RAPIDAPI_MOCK="false"

# Resend (resend.com). Si está definida, los emails salen por su API HTTP y se
# ignora todo lo de SMTP de abajo. ES NECESARIA EN PRODUCCIÓN: Render bloquea
# los puertos SMTP (25/465/587) en los web services del plan free.
# MAIL_FROM tiene que ser de un dominio verificado en Resend; uno de Gmail da 403.
RESEND_API_KEY=""

# Email SMTP (Gmail) - para el envío del mail de reseteo de contraseña
# Gmail requiere 2FA activo + una "App Password" de 16 caracteres
# (Google Account > Security > App passwords). NO es tu contraseña normal.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="tu_email@gmail.com"
SMTP_PASS="tu_app_password_de_16_chars"
MAIL_FROM="tu_email@gmail.com"

# Mercado Pago (suscripciones de los planes pagos). Opcionales: sin ellas el
# backend arranca y solo los pagos responden 503.
# Tus integraciones > tu aplicación > Credenciales. En desarrollo, las de la cuenta
# vendedora de prueba (también empiezan con APP_USR-).
MP_ACCESS_TOKEN="APP_USR-tu_access_token"
# Tus integraciones > tu aplicación > Webhooks > Clave secreta
MP_WEBHOOK_SECRET="tu_clave_secreta_de_webhooks"
# Adónde vuelve el usuario después de pagar. Mercado Pago exige una URL https
# pública: en desarrollo, el túnel al backend, que redirige al frontend. Sin
# definir, se usa FRONTEND_URL + /planes/resultado.
MP_BACK_URL="https://tu-dominio.ngrok-free.dev/api/pagos/volver"
# Solo en pruebas: el email de la cuenta compradora de prueba (el sandbox no deja
# pagar con otra). En producción, sin definir.
MP_PAYER_EMAIL_PRUEBA="test_user_123456789@testuser.com"

# App Configuration
# Peticiones por minuto y por IP (default 60). Detrás del BFF de Next todas llegan
# con la IP del frontend, así que desplegado todos comparten el cupo: subilo ahí.
THROTTLE_LIMIT=60
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:3001"
