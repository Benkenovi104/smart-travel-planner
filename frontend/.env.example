# Copiar a .env.local y ajustar.

# URL base del backend NestJS, con el prefijo /api incluido.
# Solo se lee del lado del servidor (Route Handlers y proxy.ts): el navegador
# nunca habla directo con el backend, siempre pasa por el BFF de Next.
BACKEND_URL="http://localhost:3000/api"

# Nombre de la cookie httpOnly donde el BFF guarda el JWT.
AUTH_COOKIE_NAME="stp_token"
